# ============================================
# Servease Frontend - Environment Variables
# ============================================
# Copia este archivo a .env y llena los valores:
#   cp .env.example .env
# ============================================

# Supabase (client-side auth) — required.
# En desarrollo local con VITE_DEV_AUTH=true no se usan, pero deben existir.
VITE_SUPABASE_URL=https://<proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Backend Django API
VITE_API_BASE_URL=http://localhost:8000

# --- Modo desarrollo local ---
# Pon VITE_DEV_AUTH=true para usar auth local (dev-login endpoint del backend)
# en vez de Supabase Auth. El login usa el endpoint POST /api/usuarios/dev-login/
# y guarda el JWT en localStorage. Útil cuando las Supabase keys son placeholders.
# Opcional. Default: false (usa Supabase Auth).
# VITE_DEV_AUTH=true
VITE_WS_URL=ws://localhost:8000
